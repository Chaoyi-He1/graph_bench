# graph_bench talks to any OpenAI-compatible Responses API endpoint.
# No credentials or gateway URLs are committed to this repository.
GRAPH_BENCH_LLM_BASE_URL=https://your-openai-compatible-host/v1
GRAPH_BENCH_LLM_API_KEY=sk-...
GRAPH_BENCH_LLM_MODEL=your-model-id
# Optional: reasoning effort for models that support it (low|medium|high)
#GRAPH_BENCH_LLM_EFFORT=medium

# Optional role-specific pins (override the shared values above)
#SIM_MODEL=...                 # user simulator model
#SIM_RESPONSES_BASE_URL=...    # user simulator endpoint
#JUDGE_MODEL=...               # judge model
#JUDGE_RESPONSES_BASE_URL=...  # judge endpoint
#JUDGE_REASONING_EFFORT=low

# Optional: raises GitHub API rate limits for the harvest pipeline
#GITHUB_TOKEN=ghp_...
